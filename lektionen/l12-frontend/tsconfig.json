{
  // Frontend-Code läuft im Browser: Darum kennt TypeScript hier zusätzlich die
  // DOM-APIs (document, HTMLElement, …) und versteht JSX für React.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
